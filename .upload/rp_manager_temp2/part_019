    next.longTermMemory = { version:1, guides:structuredClone(sourceRoom.longTermMemory?.guides || {}),
      firstStage:{autoEnabled:false,autoIntervalTurns:Number(sourceRoom.longTermMemory?.firstStage?.autoIntervalTurns)||20},
      nativeAuto:{enabled:false},batches:[],protectedIds:[],drafts:{} };
    next.aiContextReviewReport = null;
    next.autoRecallContextText = '';
    next.autoScanLastMessageId = '';
    next.createdAt = String(targetRoom.createdAt || nowIso());
    next.updatedAt = nowIso();
    if (!Array.isArray(next.lorePacks)) next.lorePacks = [];
    else next.lorePacks = next.lorePacks.map(pack => ({ ...pack, managedBy:'user', cards:(Array.isArray(pack.cards) ? pack.cards : []).map(card => ({ ...card, managedBy:'user', userLocked:true })) }));
    normalizeRoomSlots(next);
    return next;
  }

