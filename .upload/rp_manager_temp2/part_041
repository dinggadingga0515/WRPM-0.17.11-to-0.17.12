      if (!force && isProcessed(target)) {setStatus('이미 검토한 응답');showReviewNotice('이미 검토한 응답이에요','본문이 바뀌지 않아 API를 다시 호출하지 않았습니다. 최근 검토 결과와 처리기록에서 이전 결과를 확인할 수 있어요.','info');return;}

