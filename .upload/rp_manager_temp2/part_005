        notify(copied ? `${spec.title}을 복사했습니다.` : '지침 복사에 실패했습니다.', copied ? 'success' : 'error', 3200);
        return;
      }
      if (action === 'reset') {
        if (!confirm(`${spec.title}을 기본값으로 되돌릴까요?\n저장을 눌러야 실제 지침에 반영됩니다.`)) return;
        textarea.value=spec.defaultValue(); refresh(); textarea.focus(); return;
      }
      if (action === 'save') {
        const saveButton = backdrop.querySelector('[data-guide-action="save"]');
        saveButton.disabled=true;
        try {
          await spec.save(textarea.value); savedValue=textarea.value; refresh(); notify(`${spec.title}을 저장했습니다.`, 'success', 3200);
          backdrop.remove(); document.removeEventListener('keydown', onKeydown, true); renderModalIfOpen();
        } catch (error) {
          saveButton.disabled=false;
          notify(`지침 저장에 실패했습니다: ${error?.message || error}`, 'error', 5200);
        }
      }
    });
    document.addEventListener('keydown', onKeydown, true);
    setTimeout(()=>textarea.focus(), 0);
