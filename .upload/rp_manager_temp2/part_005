    const refresh = () => {
      const modified = spec.modified(textarea.value);
      const unsaved = textarea.value !== savedValue;
      stateLabel.textContent = `${modified ? '수정된 지침' : '기본 지침'}${unsaved ? ' · 저장 안 됨' : ''}`;
      stateLabel.classList.toggle('is-modified', modified);
      stateLabel.classList.toggle('is-dirty', unsaved);
    };
    const load = () => { spec=commonGuideEditorSpec(room, kind, variant); savedValue=spec.value(); textarea.value=savedValue; refresh(); };
    const close = () => {
      if (textarea.value !== savedValue && !confirm('저장하지 않은 지침 변경사항을 버리고 닫을까요?')) return;
      document.removeEventListener('keydown', onKeydown, true); backdrop.remove();
    };
    const onKeydown = event => { if (event.key === 'Escape') { event.preventDefault(); close(); } };
    load();
    textarea.addEventListener('input', refresh);
    variantSelect?.addEventListener('change', event => {
      if (textarea.value !== savedValue && !confirm('저장하지 않은 변경사항을 버리고 다른 지침을 열까요?')) { event.target.value=variant; return; }
      variant=normalizeLogSummaryGuideVariant(event.target.value); saveLogSummaryGuideVariant(variant, false); load();
    });
    backdrop.addEventListener('click', async event => {
      if (event.target === backdrop) { close(); return; }
