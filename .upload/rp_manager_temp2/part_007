  function rpcmPositionErrorHelp(target, pop) {
    const r = target.getBoundingClientRect();
    const gap = 8;
    pop.style.left = '12px'; pop.style.top = '12px'; pop.hidden = false;
    const pr = pop.getBoundingClientRect();
    let left = Math.min(window.innerWidth - pr.width - 12, Math.max(12, r.left));
    let top = r.bottom + gap;
    if (top + pr.height > window.innerHeight - 12) top = Math.max(12, r.top - pr.height - gap);
    pop.style.left = `${Math.round(left)}px`; pop.style.top = `${Math.round(top)}px`;
  }

  function rpcmShowErrorHelp(candidate, pinned = false) {
    if (!candidate?.el?.isConnected) return;
    const pop = rpcmEnsureErrorHelpUi(), { info } = candidate;
    rpcmErrorHelpTarget = candidate.el; rpcmErrorHelpPinned = !!pinned;
    pop.innerHTML = `<header><strong>${esc(info.kind)}</strong><button type="button" aria-label="오류 도움말 닫기">×</button></header><p><b>무슨 오류?</b> ${esc(info.detail)}</p><p><b>해결 방법</b> ${esc(info.steps)}</p><small>${pinned ? '클릭해서 고정됨 · 바깥을 누르거나 ×로 닫기' : '클릭하면 이 안내를 고정할 수 있습니다.'}</small>`;
    pop.hidden = false;
    rpcmPositionErrorHelp(candidate.el, pop);
    pop.querySelector('button').onclick = () => rpcmHideErrorHelp(true);
  }

  function rpcmHideErrorHelp(force = false) {
    if (rpcmErrorHelpPinned && !force) return;
    const pop = document.getElementById('rpcm-error-help-popover');
    if (pop) pop.hidden = true;
    rpcmErrorHelpPinned = false; rpcmErrorHelpTarget = null;
