  function rpcmBindErrorHelp() {
    if (rpcmErrorHelpBound) return;
    rpcmErrorHelpBound = true;
    document.addEventListener('pointerover', event => {
      const candidate = rpcmErrorHelpCandidate(event.target);
      if (!candidate || candidate.el.contains(event.relatedTarget)) return;
      clearTimeout(rpcmErrorHelpTimer);
      if (!rpcmErrorHelpPinned || rpcmErrorHelpTarget === candidate.el) rpcmShowErrorHelp(candidate, rpcmErrorHelpPinned);
    }, true);
    document.addEventListener('pointerout', event => {
      const candidate = rpcmErrorHelpCandidate(event.target);
      if (!candidate || candidate.el.contains(event.relatedTarget) || rpcmErrorHelpPinned) return;
      clearTimeout(rpcmErrorHelpTimer);
      rpcmErrorHelpTimer = setTimeout(() => {
        const pop = document.getElementById('rpcm-error-help-popover');
        if (!pop?.matches(':hover')) rpcmHideErrorHelp(false);
      }, 120);
    }, true);
    document.addEventListener('focusin', event => { const candidate = rpcmErrorHelpCandidate(event.target); if (candidate) rpcmShowErrorHelp(candidate, false); }, true);
    document.addEventListener('click', event => {
      const pop = event.target.closest?.('#rpcm-error-help-popover');
      if (pop) return;
      const candidate = rpcmErrorHelpCandidate(event.target);
      if (candidate) {
        const nestedControl = event.target.closest('button,a,input,select,textarea');
        if (!nestedControl || nestedControl === candidate.el) rpcmShowErrorHelp(candidate, true);
        return;
      }
      if (rpcmErrorHelpPinned) rpcmHideErrorHelp(true);
    }, true);
    document.addEventListener('keydown', event => { if (event.key === 'Escape') rpcmHideErrorHelp(true); }, true);
    window.addEventListener('resize', () => { if (rpcmErrorHelpTarget && !document.getElementById('rpcm-error-help-popover')?.hidden) rpcmPositionErrorHelp(rpcmErrorHelpTarget, document.getElementById('rpcm-error-help-popover')); }, { passive:true });
    window.addEventListener('scroll', () => { if (!rpcmErrorHelpPinned) rpcmHideErrorHelp(false); }, { passive:true, capture:true });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', rpcmBindErrorHelp, { once:true });
