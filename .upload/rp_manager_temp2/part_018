        if (collapseBtn) collapseBtn.disabled = true;
        if (formatEl) formatEl.textContent = kind === 'currentState' ? '⚠ 현재상태 블록 문법 미감지' : kind === 'logSummary' ? '⚠ 날짜 블록 문법 미감지' : '원문 편집 모드';
