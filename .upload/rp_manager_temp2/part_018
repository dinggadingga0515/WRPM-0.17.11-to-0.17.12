      const changed = userEdited && normalizeLineBreaks(nextText).trim() !== normalizeLineBreaks(originalText).trim();
      if (!changed) { close(true); return; }
      let nextLogBlocks = null;
      let logKeyMap = null;
      if (kind === 'logSummary') {
        nextLogBlocks = parseDatedLogBlocks(nextText);
