            } else if (choice === 'excluded') {
              setRoomLogSelectionKey('autoLogExcludedKeys', key, input.checked);
              if (input.checked) {
                const pinned = card.querySelector('[data-log-choice="pinned"]');
                if (pinned) pinned.checked = false;
