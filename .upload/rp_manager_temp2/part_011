  function storyTimelineInjectionItems(room) {
    if (room?.storyTimelineInjectionEnabled === false) return [];
    const cards = storyTimelineCardsFor(room).filter(card => card.inject && (card.title || card.content));
    if (!cards.length) return [];
    const content = cards.map(card => {
      const source = card.timelineLabel && card.timelineLabel !== DEFAULT_LOG_TIMELINE ? ` · ${card.timelineLabel}` : '';
      const tags = (card.tags || []).length ? `\n태그: ${(card.tags || []).map(tag => `#${tag}`).join(' ')}` : '';
      return `[${storyCardDateLabel(card)}${source}] ${card.title || '제목 없음'}\n${card.content || ''}${tags}`.trim();
    }).join('\n\n');
    return [{
      slotId:'story-timeline:master', title:'연속성 타임라인', group:'story-timeline', content,
      totalTurns:0, usedTurns:0, autoType:'story-timeline', recallReason:'항상 유지되는 하나의 서사 골격',
    }];
  }

  function makeStoryLogId() {
    return `log_${Date.now().toString(36)}${Math.random().toString(36).slice(2, 7)}`;
  }

  function storyLogFingerprint(block) {
    return simpleHash(`${String(block?.heading || '')}\n${String(block?.body || '')}`);
  }

  function normalizeStoryLogReviews(room) {
    if (!room || typeof room !== 'object') return [];
    const log = (room.slots || []).find(slot => slot.id === 'logSummary');
    const blocks = parseDatedLogBlocks(String(log?.content || ''));
    const old = Array.isArray(room.storyLogReviews) ? room.storyLogReviews.filter(item => item && typeof item === 'object') : [];
    const byKey = new Map(old.map(item => [String(item.blockKey || ''), item]));
    const usedIds = new Set();
    const next = [];
    for (const block of blocks) {
      let meta = byKey.get(String(block.key));
      if (!meta) {
        const candidates = old.filter(item => !usedIds.has(String(item.logId)) && String(item.calendarDateKey || '') === String(block.calendarDateKey || '') && String(item.timelineKey || '') === String(block.timelineKey || ''));
        if (candidates.length === 1) meta = candidates[0];
      }
      const fingerprint = storyLogFingerprint(block);
      const changed = !!meta && String(meta.fingerprint || '') !== fingerprint;
      let logId = String(meta?.logId || '');
      if (!/^log_[A-Za-z0-9_-]+$/.test(logId) || usedIds.has(logId)) logId = makeStoryLogId();
      usedIds.add(logId);
      next.push({
        logId,
        blockKey:String(block.key),
        calendarDateKey:String(block.calendarDateKey || ''),
        timelineKey:String(block.timelineKey || ''),
        fingerprint,
        version:Math.max(1, Number(meta?.version || 1) + (changed ? 1 : 0)),
