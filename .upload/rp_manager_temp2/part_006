  function formatAiCostUsd(value) {
    const amount = Number(value);
    if (!Number.isFinite(amount) || amount < 0) return '단가 미설정';
    if (amount > 0 && amount < 0.0001) return '$0.0001 미만';
    if (amount < 0.01) return `$${amount.toFixed(4)}`;
    if (amount < 1) return `$${amount.toFixed(3)}`;
    return `$${amount.toFixed(2)}`;
  }

  function emptyRoomAiFeatureUsage() {
    return { calls:0, inputTokens:0, outputTokens:0, costUsd:0, estimatedCalls:0, unpricedCalls:0 };
  }

  function normalizeRoomAiUsage(room) {
    if (!room || typeof room !== 'object') return { version:1, features:{ summary:emptyRoomAiFeatureUsage(), timeline:emptyRoomAiFeatureUsage(), context:emptyRoomAiFeatureUsage(), itemFolder:emptyRoomAiFeatureUsage(), utility:emptyRoomAiFeatureUsage(), responseRefiner:emptyRoomAiFeatureUsage(), longTermManualFirst:emptyRoomAiFeatureUsage(), longTermAutoFirst:emptyRoomAiFeatureUsage(), longTermSecond:emptyRoomAiFeatureUsage(), longTermNative:emptyRoomAiFeatureUsage() }, history:[] };
    const hasStoredUsage = !!(room.aiApiUsage && typeof room.aiApiUsage === 'object');
    const source = hasStoredUsage ? room.aiApiUsage : {};
    const sourceFeatures = source.features && typeof source.features === 'object' ? source.features : {};
    const features = {};
    for (const feature of ['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery']) {
      const saved = sourceFeatures[feature] && typeof sourceFeatures[feature] === 'object' ? sourceFeatures[feature] : {};
      features[feature] = {
        calls:Math.max(0, Number(saved.calls) || 0),
        inputTokens:Math.max(0, Number(saved.inputTokens) || 0),
        outputTokens:Math.max(0, Number(saved.outputTokens) || 0),
        costUsd:Math.max(0, Number(saved.costUsd) || 0),
        estimatedCalls:Math.max(0, Number(saved.estimatedCalls) || 0),
        unpricedCalls:Math.max(0, Number(saved.unpricedCalls) || 0),
      };
    }
    let history = (Array.isArray(source.history) ? source.history : []).filter(item => item && typeof item === 'object').slice(0, AI_ROOM_USAGE_HISTORY_LIMIT).map(item => ({
      id:String(item.id || ''), at:String(item.at || ''), feature:['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery'].includes(item.feature) ? item.feature : 'summary',
      provider:String(item.provider || ''), model:String(item.model || ''), inputTokens:Math.max(0, Number(item.inputTokens) || 0), outputTokens:Math.max(0, Number(item.outputTokens) || 0),
      costUsd:item.costUsd == null || !Number.isFinite(Number(item.costUsd)) ? null : Math.max(0, Number(item.costUsd)), estimated:!!item.estimated, callCount:Math.max(1, Number(item.callCount) || 1),
    }));
    // v0.12.42 이전에 방 안의 생성 이력에 남은 실제 usage 토큰·당시 비용을 1회만 복원합니다.
    // 방을 구분할 수 없는 기존 브라우저 전체 누적값은 섞지 않습니다.
    if (!hasStoredUsage) {
      const legacyRuns = [
        ...(Array.isArray(room.aiSummaryHistory) ? room.aiSummaryHistory : []).map(item => ({ feature:'summary', item })),
        ...(Array.isArray(room.storyTimelineApiHistory) ? room.storyTimelineApiHistory : []).map(item => ({ feature:'timeline', item })),
      ];
      for (const [legacyIndex, legacy] of legacyRuns.entries()) {
        const saved = legacy.item?.usage && typeof legacy.item.usage === 'object' ? legacy.item.usage : {};
        const calls = Math.max(0, Number(saved.calls) || 0);
        if (!calls) continue;
        const inputTokens = Math.max(0, Number(saved.inputTokens) || 0);
        const outputTokens = Math.max(0, Number(saved.outputTokens) || 0);
        const unpricedCalls = Math.max(0, Math.min(calls, Number(saved.unpricedCalls) || 0));
        const storedCost = Number(saved.estimatedCostUsd);
        const costUsd = Number.isFinite(storedCost) && unpricedCalls < calls ? Math.max(0, storedCost) : null;
        const estimated = inputTokens <= 0 || outputTokens <= 0;
        const aggregate = features[legacy.feature];
        aggregate.calls += calls;
        aggregate.inputTokens += inputTokens;
        aggregate.outputTokens += outputTokens;
        if (costUsd != null) aggregate.costUsd += costUsd;
        aggregate.unpricedCalls += unpricedCalls;
        if (estimated) aggregate.estimatedCalls += calls;
        history.push({
          id:`LEGACY_${legacy.feature}_${legacy.item?.id || legacyIndex}`,
          at:String(legacy.item?.createdAt || legacy.item?.appliedAt || ''), feature:legacy.feature,
          provider:String(legacy.item?.provider || ''), model:String(legacy.item?.model || ''),
          inputTokens, outputTokens, costUsd, estimated, callCount:calls,
        });
      }
      history.sort((a, b) => String(b.at || '').localeCompare(String(a.at || '')));
      history = history.slice(0, AI_ROOM_USAGE_HISTORY_LIMIT);
    }
    room.aiApiUsage = { version:1, features, history, legacyImported:true };
    return room.aiApiUsage;
  }

  function roomAiUsageTotals(room) {
    const usage = normalizeRoomAiUsage(room);
    return Object.values(usage.features).reduce((total, item) => {
      total.calls += item.calls;
      total.inputTokens += item.inputTokens;
      total.outputTokens += item.outputTokens;
      total.costUsd += item.costUsd;
      total.estimatedCalls += item.estimatedCalls;
      total.unpricedCalls += item.unpricedCalls;
      return total;
    }, emptyRoomAiFeatureUsage());
  }

  function recordRoomAiUsage(room, feature, provider, model, usage = {}, pricing = {}, source = {}) {
    if (!room || typeof room !== 'object') return null;
    const normalizedFeature = ['summary','timeline','context','itemFolder','utility','responseRefiner','longTermManualFirst','longTermAutoFirst','longTermSecond','longTermNative','semanticIndex','semanticQuery'].includes(feature) ? feature : 'summary';
    const reportedInput = Math.max(0, Number(usage.inputTokens) || 0);
    const reportedOutput = Math.max(0, Number(usage.outputTokens) || 0);
    const inputEstimated = reportedInput <= 0;
    const embedding=['semanticIndex','semanticQuery'].includes(normalizedFeature);
    const outputEstimated = !embedding && reportedOutput <= 0;
    const inputTokens = inputEstimated ? Math.max(1, Math.ceil((String(source.systemInstruction || '').length + String(source.prompt || '').length) / 3)) : reportedInput;
    const outputTokens = embedding ? 0 : outputEstimated ? Math.max(1, Math.ceil(String(source.text || '').length / 3)) : reportedOutput;
    const estimated = inputEstimated || outputEstimated;
    const costUsd = estimateAiCostUsd({ inputTokens, outputTokens }, pricing);
    const state = normalizeRoomAiUsage(room);
    const aggregate = state.features[normalizedFeature];
    aggregate.calls += 1;
    aggregate.inputTokens += inputTokens;
    aggregate.outputTokens += outputTokens;
    if (costUsd == null) aggregate.unpricedCalls += 1;
    else aggregate.costUsd += costUsd;
    if (estimated) aggregate.estimatedCalls += 1;
    const entry = {
      id:`API_${Date.now().toString(36)}${Math.random().toString(36).slice(2,7)}`,
      at:nowIso(), feature:normalizedFeature, provider:String(provider || ''), model:String(model || ''),
      inputTokens, outputTokens, costUsd, estimated, callCount:1,
    };
    state.history.unshift(entry);
    state.history = state.history.slice(0, AI_ROOM_USAGE_HISTORY_LIMIT);
    return entry;
  }

